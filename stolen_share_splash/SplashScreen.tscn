[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0.0, 2.0) = 1.15;
uniform float softness : hint_range(0.0, 1.0) = 0.55;

void fragment() {
	vec2 uv = UV - vec2(0.5);
	float dist = length(uv) * strength;
	float vig = smoothstep(0.85, 0.85 - softness, dist);
	COLOR = vec4(0.0, 0.0, 0.0, 1.0 - vig);
}
"

